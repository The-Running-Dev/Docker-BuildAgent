{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-Command",
              "& (Join-Path $HOME '.agent-kit/tools/Measure-Session.ps1') -Watch"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
